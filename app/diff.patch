diff --git a/app/src/timer.c b/app/src/timer.c
index 8a4c924..f5614f6 100644
--- a/app/src/timer.c
+++ b/app/src/timer.c
@@ -7,14 +7,67 @@
 #include "timer.h"
 #include "action.h"
 
+#define  TIMER_INDEX(x) ((x) % WORKER_TIMER_NUM)    
+#define WORKER_TIMER_REGISTER(fn)                                   \
+    do {                                                            \
+        if (worker_timer_idx < WORKER_TIMER_NUM) {                  \
+            k_timer_init(&worker_timer[worker_timer_idx], fn, NULL);\
+            worker_timer_idx++;                                     \
+        }                                                           \
+    } while (0)
+
+#define WORKER_TIMER_COUNT()  (worker_timer_idx)
+
+
 LOG_MODULE_REGISTER(timer, LOG_LEVEL_INF);
 
 static int index = 0;
 static struct k_timer test_timer;
+static struct k_timer worker_timer[WORKER_TIMER_NUM];
+static int worker_timer_idx = 0;
+
+int init_work_timer(work_timer_t *work_timer, int period_seconds, void (*callback)(struct k_timer *timer))
+{
+    if (work_timer == NULL || callback == NULL || period_seconds <= 0) {
+        return -EINVAL;
+    }
+
+    work_timer->is_active = false;
+    work_timer->period_seconds = period_seconds;
+    work_timer->callback = callback;
+    WORKER_TIMER_REGISTER(work_timer->callback);
+    return 0;
+}
+
+int start_work_timer(work_timer_t *work_timer)
+{
+    if (work_timer == NULL || work_timer->timer == NULL) {
+        return -EINVAL;
+    }
+
+    if (!work_timer->is_active) {
+        k_timer_start(work_timer->timer, K_SECONDS(work_timer->period_seconds), K_SECONDS(work_timer->period_seconds));
+        work_timer->is_active = true;
+    }
+    return 0;
+}
+
+int stop_work_timer(work_timer_t *work_timer)
+{
+    if (work_timer == NULL || work_timer->timer == NULL) {
+        return -EINVAL;
+    }
+
+    if (work_timer->is_active) {
+        k_timer_stop(work_timer->timer);
+        work_timer->is_active = false;
+    }
+    return 0;
+}
 
