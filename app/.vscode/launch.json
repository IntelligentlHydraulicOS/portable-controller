{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug nRF54L15 (J-Link)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "jlink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/app/zephyr/zephyr.elf",
            "device": "nRF54L15_M33",
            "interface": "swd",
            "runToEntryPoint": "main",
            "preLaunchCommands": [
                "monitor reset"
            ],
            "postLaunchCommands": [
                "monitor speed 4000"
            ]
        }
    ]
}