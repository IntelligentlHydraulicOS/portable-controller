#include <dt-bindings/pinctrl/nrf-pinctrl.h>


/ {
    /* RS-485 方向控制引脚 (DE/RE) - P1.06 */
    rs485_ctrl: rs485-ctrl {
        compatible = "gpio-leds";
        de: de {
            gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;
            label = "RS485 DE";
        };
    };

    /* Zigbee 控制引脚 */
    zigbee_ctrl: zigbee-ctrl {
        compatible = "gpio-leds";
        link_zig: link_zig {
            gpios = <&gpio1 14 GPIO_ACTIVE_HIGH>;
            label = "Zigbee Link";
        };
        mode_zig: mode_zig {
            gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>;
            label = "Zigbee Mode";
        };
    };

    /* 自定义 pinctrl */
    my_pinctrl: pinctrl {
        compatible = "nordic,nrf-pinctrl";
        uart21_default: uart21_default {
            group1 {
                psels = <NRF_PSEL(UART_TX, 1, 4)>,
                        <NRF_PSEL(UART_RX, 1, 5)>;
            };
        };
        uart22_default: uart22_default {
            group1 {
                psels = <NRF_PSEL(UART_TX, 1, 12)>,
                        <NRF_PSEL(UART_RX, 1, 13)>;
            };
        };
    };
};

/* RS-485 UART - 不再设置 rts-gpios */
&uart21 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart21_default>;
    pinctrl-names = "default";
};

/* Zigbee UART */
&uart22 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart22_default>;
    pinctrl-names = "default";
};
&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    /* 为 P1.07 (AIN3) 配置 ADC 通道 */
    channel@3 {                    // 1. reg 必须与通道号一致
        reg = <3>;                 // AIN3 对应数字 3[reference:6]
        zephyr,gain = "ADC_GAIN_1_6"; /* [reference:8]增益 1/6，可测量最高 VDD 电压 */
        zephyr,reference = "ADC_REF_INTERNAL"; /* [reference:9]使用内部参考电压 (0.9V)[reference:10] */
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN3>; /* [reference:11]指定使用 AIN3 */
        zephyr,resolution = <12>;  /* [reference:13]14位ADC, 常用12位分辨率 */
    };
};