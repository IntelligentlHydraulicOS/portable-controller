#include <dt-bindings/pinctrl/nrf-pinctrl.h>
#include <dt-bindings/gpio/gpio.h>

/ {
    chosen {
        zephyr,settings-nvs-partition = &storage_partition;
    };

    zephyr,user {
        io-channels = <&adc 4>, <&adc 2>;
        buzzer-gpios = <&gpio2 4 GPIO_ACTIVE_HIGH>;
        r-led-en-gpios = <&gpio2 10 GPIO_ACTIVE_HIGH>; // 红灯使能
        b-led-en-gpios = <&gpio2 5 GPIO_ACTIVE_HIGH>;  // 蓝灯使能
        g-led-en-gpios = <&gpio2 0 GPIO_ACTIVE_HIGH>;  // 绿灯使能
        linkled-led-en-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;  // link LED
        running-led-en-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;  // running LED
    };
};

&pinctrl {
    /* UART20 (P2.08 TX, P2.07 RX) */
    // uart20_default: uart20_default {
    //     group1 {
    //         psels = <NRF_PSEL(UART_TX, 2, 8)>,
    //                 <NRF_PSEL(UART_RX, 2, 7)>;
    //     };
    //     /delete-node/ group2;
    // };
    // uart20_sleep: uart20_sleep {
    //     group1 {
    //         psels = <NRF_PSEL(UART_TX, 2, 8)>,
    //                 <NRF_PSEL(UART_RX, 2, 7)>;
    //         low-power-enable;
    //     };
    // };

    /* UART21 (P1.04 TX, P1.05 RX) */
    uart21_default: uart21_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 4)>,
                    <NRF_PSEL(UART_RX, 1, 5)>;
        };
    };

    /* UART22 (P1.12 TX, P1.13 RX) */
    uart22_default: uart22_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 12)>,
                    <NRF_PSEL(UART_RX, 1, 13)>;
        };
    };
};

&uart20 {
    status = "disabled";
    // current-speed = <115200>;
    // pinctrl-0 = <&uart20_default>;
    // pinctrl-1 = <&uart20_sleep>;
    // pinctrl-names = "default", "sleep";
};

&uart21 {
    status = "okay";
    current-speed = <115200>;
    interrupts = < 0xc7 0x0 >;
    pinctrl-0 = <&uart21_default>;
    pinctrl-names = "default";
};

&uart22 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart22_default>;
    pinctrl-names = "default";
};

/* ================================================================
 * ADC 配置
 * ================================================================ */
&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@4 {
        reg = <4>;
        zephyr,gain = "ADC_GAIN_1_4";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN4>;
        zephyr,resolution = <12>;
    };
    channel@2 {
        reg = <2>;
        zephyr,gain = "ADC_GAIN_1_4";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN2>;
        zephyr,resolution = <12>;
    };
};

&nfct {
    status = "okay";
};

/* ================================================================
 * 分区表（保留原样，确保 FLPR 预留）
 * ================================================================ */
/delete-node/ &slot0_partition;
/delete-node/ &slot1_partition;
/delete-node/ &storage_partition;

&cpuapp_rram {
    partitions {
        ranges;
        #address-cells = <1>;
        #size-cells = <1>;

        slot0_partition: partition@10000 {
            compatible = "zephyr,mapped-partition";
            label = "image-0";
            reg = <0x10000 0x63C00>;
        };

        slot1_partition: partition@73C00 {
            compatible = "zephyr,mapped-partition";
            label = "image-1";
            reg = <0x73C00 0x63C00>;
        };

        storage_partition: partition@D7800 {
            compatible = "zephyr,mapped-partition";
            label = "storage";
            reg = <0xD7800 0xB000>;
        };

        littlefs_storage_partition: partition@E2800 {
            compatible = "zephyr,mapped-partition";
            label = "littlefs_storage";
            reg = <0xE2800 0x82000>;
        };
    };
};
