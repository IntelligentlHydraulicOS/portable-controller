#include <dt-bindings/pinctrl/nrf-pinctrl.h>
#include <dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/led/led.h>
/ {
    chosen {
        zephyr,settings-nvs-partition = &storage_partition;
    };

    zephyr,user {
        io-channels = <&adc 3>;
        buzzer-gpios = <&gpio2 4 GPIO_ACTIVE_HIGH>;
    };

    aliases {
        led-strip = &led_strip;
    };
};

/* ================================================================
 * SPI 模拟 WS2811 (P1.11)
 * ================================================================ */
&spi20 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi20_led_default>;
    pinctrl-names = "default";

    led_strip: ws2811@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <2>;
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
        spi-zero-frame = <0x40>;
        spi-one-frame  = <0x70>;
    };
};

&pinctrl {
    spi20_led_default: spi20_led_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 11)>;
        };
    };

    uart21_default: uart21_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 4)>,
                    <NRF_PSEL(UART_RX, 1, 5)>;
        };
    };

    uart22_default: uart22_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 12)>,
                    <NRF_PSEL(UART_RX, 1, 13)>;
        };
    };
};

&uart20 {
    status = "disabled";
};

&uart21 {
    status = "okay";
    current-speed = <115200>;
    interrupts = < 0xc7 0x0 >;
    pinctrl-0 = <&uart21_default>;
    pinctrl-names = "default";
};

&uart22 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart22_default>;
    pinctrl-names = "default";
};

&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@3 {
        reg = <3>;
        zephyr,gain = "ADC_GAIN_1_4";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN3>;
        zephyr,resolution = <12>;
    };
};

&nfct {
    status = "okay";
};

/* ================================================================
 * 分区（保留 FLPR 预留）：
 *   boot 62K / slot0 400K / slot1 400K / NVS 44K / LittleFS 520K
 * ================================================================ */
// /delete-node/ &boot_partition;
/delete-node/ &slot0_partition;
/delete-node/ &slot1_partition;
/delete-node/ &storage_partition;

&cpuapp_rram {
    partitions {
        // boot_partition: partition@0 {
        //     compatible = "zephyr,mapped-partition";
        //     label = "mcuboot";
        //     reg = <0x0 0xF800>;        /* 62KB */
        // };

        slot0_partition: partition@F800 {
            compatible = "zephyr,mapped-partition";
            label = "image-0";
            reg = <0x10000 0x63C00>;    /* 408KB */
        };

        slot1_partition: partition@73800 {
            compatible = "zephyr,mapped-partition";
            label = "image-1";
            reg = <0x73C00 0x63C00>;   /* 约408KB */
        };

        storage_partition: partition@D7800 {
            compatible = "zephyr,mapped-partition";
            label = "storage";
            reg = <0xD7800 0xB000>;    /* 44KB */
        };

        littlefs_storage_partition: partition@E2800 {
            compatible = "zephyr,mapped-partition";
            label = "littlefs_storage";
            reg = <0xE2800 0x82000>;   /* 520KB */
        };
    };
};
