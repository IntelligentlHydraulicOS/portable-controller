#include <dt-bindings/pinctrl/nrf-pinctrl.h>


/ {
    /* RS-485 方向控制引脚 (DE/RE) - P1.06 */
    rs485_ctrl: rs485-ctrl {
        compatible = "gpio-leds";
        de: de {
            gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;
            label = "RS485 DE";
        };
    };

    /* Zigbee 控制引脚 */
    zigbee_ctrl: zigbee-ctrl {
        compatible = "gpio-leds";
        link_zig: link_zig {
            gpios = <&gpio1 14 GPIO_ACTIVE_HIGH>;
            label = "Zigbee Link";
        };
        mode_zig: mode_zig {
            gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>;
            label = "Zigbee Mode";
        };
    };

    /* 自定义 pinctrl */
    my_pinctrl: pinctrl {
        compatible = "nordic,nrf-pinctrl";
        uart21_default: uart21_default {
            group1 {
                psels = <NRF_PSEL(UART_TX, 1, 4)>,
                        <NRF_PSEL(UART_RX, 1, 5)>;
            };
        };
        uart22_default: uart22_default {
            group1 {
                psels = <NRF_PSEL(UART_TX, 1, 12)>,
                        <NRF_PSEL(UART_RX, 1, 13)>;
            };
        };
    };
};

/* RS-485 UART - 不再设置 rts-gpios */
&uart21 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart21_default>;
    pinctrl-names = "default";
};

/* Zigbee UART */
&uart22 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart22_default>;
    pinctrl-names = "default";
};
