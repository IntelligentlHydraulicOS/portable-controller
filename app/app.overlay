/*
 * PTR54L15X (nRF54L15) 设备树覆盖文件
 * 目的：释放 P1.06 作为 RS-485 DE 控制引脚，并将控制台日志输出到 RTT
 */

#include <dt-bindings/pinctrl/nrf-pinctrl.h>
#include <dt-bindings/gpio/gpio.h>

/ {
    /* ADC 采样通道：P1.07 (AIN3) */
    zephyr,user {
        io-channels = <&adc 3>;
    };
};

/* ================================================================
 * 关键：禁用 uart20，彻底释放 P1.06 (RTS) 和 P1.07 (CTS)
 * ================================================================ */
&uart20 {
    status = "disabled";
};

/* ================================================================
 * 注意：不再将 uart21 或 uart22 用作 console/shell
 * 控制台日志将通过 RTT 输出，由 prj.conf 中的 Kconfig 配置
 * ================================================================ */

/* ================================================================
 * RS-485 UART (uart21)
 * ================================================================ */
&uart21 {
    status = "okay";
    current-speed = <115200>;
    interrupts = < 0xc7 0x0 >; // 将优先级从 0x1 改为 0x0
    // clocks = <&hfpll>;  /* 强制使用 PLL（源自 HFXO） */
    pinctrl-0 = <&uart21_default>;
    pinctrl-names = "default";
};

&pinctrl {
    uart21_default: uart21_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 4)>,
                    <NRF_PSEL(UART_RX, 1, 5)>;
        };
    };
};

/* ================================================================
 * Zigbee UART (uart22)
 * ================================================================ */
&uart22 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart22_default>;
    pinctrl-names = "default";
};

&pinctrl {
    uart22_default: uart22_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 12)>,
                    <NRF_PSEL(UART_RX, 1, 13)>;
        };
    };
};

/* ================================================================
 * ADC 配置：P1.07 (AIN3)
 * ================================================================ */
&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@3 {
        reg = <3>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN3>;
        zephyr,resolution = <12>;
    };
};
