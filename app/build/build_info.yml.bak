cmake:
  board:
    name: 'nrf54l15dk'
    path:
     - '/home/binbin/ncs-workspace/zephyr/boards/nordic/nrf54l15dk'
    qualifiers: 'nrf54l15/cpuapp'
    revision: ''
  images:
   - name: 'app'
     source-dir: '/home/binbin/ncs-workspace/moving_controler/app'
     type: 'MAIN'
  kconfig:
    files:
     - '/home/binbin/ncs-workspace/moving_controler/app/build/_sysbuild/empty.conf'
     - '/home/binbin/ncs-workspace/moving_controler/app/build/_sysbuild/empty.conf'
    user-files:
     - '/home/binbin/ncs-workspace/moving_controler/app/build/_sysbuild/empty.conf'
version: '0.1.0'
west:
  command: '/home/binbin/ncs-workspace/.venv/bin/west build -p always -b nrf54l15dk/nrf54l15/cpuapp .'
  topdir: '/home/binbin/ncs-workspace'
  version: '1.5.0'
